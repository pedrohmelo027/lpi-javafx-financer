<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>


<BorderPane fx:id="rootPane" prefHeight="800.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestaofinanceira.view.MenuView">
    
    <!-- Top Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
            </padding>
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="header-title" text="Financer" wrapText="true" />
                        <Label styleClass="header-subtitle" text="Controle Financeiro Pessoal" wrapText="true" />
                    </children>
                </VBox>
                
                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <!-- Open Charts Button -->
                        <Button fx:id="btnOpenChartsHeader" onAction="#handleShowCharts" styleClass="btn-secondary" text="📈 Análise Gráfica" />
                        
                        <!-- Theme Toggle Button -->
                        <Button fx:id="btnThemeToggle" onAction="#handleThemeToggle" styleClass="btn-secondary" text="☀️ Tema Claro" />
                        
                        <!-- Month & Year Filters -->
                        <HBox alignment="CENTER" spacing="12.0" styleClass="filter-container">
                            <padding>
                                <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                            </padding>
                            <children>
                                <Label styleClass="filter-label" text="Período:" wrapText="true" />
                                <ComboBox fx:id="cbFilterMonth" prefWidth="130.0" promptText="Mês" styleClass="modern-combo" />
                                <ComboBox fx:id="cbFilterYear" prefWidth="100.0" promptText="Ano" styleClass="modern-combo" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <!-- Center Workspace with TabPane Navigation -->
    <center>
        <TabPane fx:id="mainTabPane" styleClass="main-tabs" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <!-- Tab 1: Painel Principal / Controle Financeiro -->
                <Tab text="📊 Painel Principal">
                    <content>
                        <HBox spacing="20.0">
                            <padding>
                                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                            </padding>
                            <children>
                                
                                <!-- Left Panel: Summary + Transactions Table (65% width) -->
                                <VBox spacing="20.0" HBox.hgrow="ALWAYS" prefWidth="800.0">
                                    <children>
                                        
                                        <!-- Resumo / KPI Cards -->
                                        <HBox spacing="15.0">
                                            <children>
                                                
                                                <!-- Card Entradas -->
                                                <VBox styleClass="kpi-card, kpi-income" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <Label styleClass="kpi-icon-container" text="▲" wrapText="true" />
                                                                <Label styleClass="kpi-title" text="Receitas" wrapText="true" />
                                                            </children>
                                                        </HBox>
                                                        <Label fx:id="lblTotalIncome" styleClass="kpi-value" text="R$ 0,00" wrapText="true" />
                                                    </children>
                                                </VBox>
                                                
                                                <!-- Card Saídas -->
                                                <VBox styleClass="kpi-card, kpi-expense" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <Label styleClass="kpi-icon-container" text="▼" wrapText="true" />
                                                                <Label styleClass="kpi-title" text="Despesas" wrapText="true" />
                                                            </children>
                                                        </HBox>
                                                        <Label fx:id="lblTotalExpenses" styleClass="kpi-value" text="R$ 0,00" wrapText="true" />
                                                    </children>
                                                </VBox>
                                                
                                                <!-- Card Investido -->
                                                <VBox styleClass="kpi-card, kpi-invested" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <Label styleClass="kpi-icon-container" text="📈" wrapText="true" />
                                                                <Label styleClass="kpi-title" text="Investido" wrapText="true" />
                                                            </children>
                                                        </HBox>
                                                        <Label fx:id="lblTotalInvested" styleClass="kpi-value" text="R$ 0,00" wrapText="true" />
                                                    </children>
                                                </VBox>
                                                
                                                <!-- Card Saldo -->
                                                <VBox fx:id="cardBalance" styleClass="kpi-card, kpi-balance" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <Label styleClass="kpi-icon-container" text="💰" wrapText="true" />
                                                                <Label styleClass="kpi-title" text="Saldo Atual" wrapText="true" />
                                                            </children>
                                                        </HBox>
                                                        <Label fx:id="lblBalance" styleClass="kpi-value" text="R$ 0,00" wrapText="true" />
                                                    </children>
                                                </VBox>
                                                
                                            </children>
                                        </HBox>
                                        
                                        <!-- Table Card -->
                                        <VBox styleClass="card-container" VBox.vgrow="ALWAYS">
                                            <padding>
                                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                            </padding>
                                            <children>
                                                <HBox alignment="CENTER_LEFT" styleClass="card-header">
                                                    <VBox.margin>
                                                        <Insets bottom="10.0" />
                                                    </VBox.margin>
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                                                            <children>
                                                                <Label styleClass="card-title" text="Movimentações" wrapText="true" />
                                                                <!-- View Toggle Segmented Control -->
                                                                <HBox spacing="5.0" styleClass="segmented-control">
                                                                    <children>
                                                                        <Button fx:id="btnViewTable" onAction="#handleShowTable" styleClass="btn-segmented, btn-segmented-active" text="📋 Tabela" />
                                                                        <Button fx:id="btnViewCharts" onAction="#handleShowCharts" styleClass="btn-segmented" text="📈 Gráficos" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </HBox>
                                                        <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <!-- Action Buttons (+ Nova Receita, + Nova Despesa) -->
                                                                <Button fx:id="btnNewIncome" onAction="#handleNewIncome" styleClass="btn-action-income" text="+ Nova Receita" />
                                                                <Button fx:id="btnNewExpense" onAction="#handleNewExpense" styleClass="btn-action-expense" text="+ Nova Despesa" />
                                                                <Button fx:id="btnExportCSV" onAction="#handleExportCSV" styleClass="btn-secondary" text="📥 CSV" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </HBox>
                                                
                                                <StackPane VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <!-- Comprehensive TableView with all columns -->
                                                        <TableView fx:id="tvTransactions" styleClass="modern-table">
                                                            <columns>
                                                                <TableColumn fx:id="colDate" prefWidth="90.0" text="Data" />
                                                                <TableColumn fx:id="colCategory" prefWidth="110.0" text="Categoria" />
                                                                <TableColumn fx:id="colType" prefWidth="90.0" text="Tipo" />
                                                                <TableColumn fx:id="colAmount" prefWidth="105.0" text="Valor" />
                                                                <TableColumn fx:id="colDescription" prefWidth="180.0" text="Descrição" />
                                                                <TableColumn fx:id="colActions" prefWidth="115.0" text="Ações" sortable="false" />
                                                            </columns>
                                                            <columnResizePolicy>
                                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                            </columnResizePolicy>
                                                        </TableView>
                                                        
                                                        <!-- Large Spacious Charts TabPane inside StackPane -->
                                                        <TabPane fx:id="paneCharts" styleClass="chart-tabs" tabClosingPolicy="UNAVAILABLE" visible="false" managed="false">
                                                            <tabs>
                                                                <Tab text="Fluxo Anual de Caixa (Barras)">
                                                                    <content>
                                                                        <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: transparent;">
                                                                            <children>
                                                                                <BarChart fx:id="chartMonthlyComparison" legendSide="BOTTOM" styleClass="modern-chart" title="Comparativo de Receitas vs Despesas (Todos os Meses)" VBox.vgrow="ALWAYS">
                                                                                    <xAxis>
                                                                                        <CategoryAxis fx:id="categoryAxis" label="Meses" side="BOTTOM" />
                                                                                    </xAxis>
                                                                                    <yAxis>
                                                                                        <NumberAxis fx:id="numberAxis" label="Valor (R$)" side="LEFT" />
                                                                                    </yAxis>
                                                                                </BarChart>
                                                                            </children>
                                                                            <padding>
                                                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                                                            </padding>
                                                                        </VBox>
                                                                    </content>
                                                                </Tab>
                                                                <Tab text="Gastos por Categoria (Pizza)">
                                                                    <content>
                                                                        <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: transparent;">
                                                                            <children>
                                                                                <PieChart fx:id="chartCategories" styleClass="modern-chart" title="Distribuição de Despesas por Categoria" VBox.vgrow="ALWAYS" />
                                                                            </children>
                                                                            <padding>
                                                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                                                            </padding>
                                                                        </VBox>
                                                                    </content>
                                                                </Tab>
                                                            </tabs>
                                                        </TabPane>
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </VBox>
                                        
                                    </children>
                                </VBox>
                                
                                <!-- Right Panel: Form + Analytics Launch Card (35% width) -->
                                <VBox spacing="20.0" prefWidth="440.0" minWidth="400.0">
                                    <children>
                                        
                                        <!-- Form Card -->
                                        <VBox styleClass="card-container, form-card">
                                            <padding>
                                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                            </padding>
                                            <children>
                                                <Label fx:id="lblFormTitle" styleClass="card-title" text="Nova Movimentação" wrapText="true">
                                                    <VBox.margin>
                                                        <Insets bottom="12.0" />
                                                    </VBox.margin>
                                                </Label>
                                                
                                                <GridPane hgap="10.0" vgap="10.0">
                                                    <columnConstraints>
                                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                    </columnConstraints>
                                                    <rowConstraints>
                                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                                    </rowConstraints>
                                                    <children>
                                                        
                                                        <!-- Tipo de Transação -->
                                                        <VBox spacing="5.0" GridPane.columnSpan="2">
                                                            <children>
                                                                <Label styleClass="form-label" text="Tipo de Movimentação" wrapText="true" />
                                                                <HBox spacing="15.0">
                                                                    <children>
                                                                        <RadioButton fx:id="rbIncome" selected="true" styleClass="modern-radio" text="Receita">
                                                                            <toggleGroup>
                                                                                <ToggleGroup fx:id="tgType" />
                                                                            </toggleGroup>
                                                                        </RadioButton>
                                                                        <RadioButton fx:id="rbExpense" styleClass="modern-radio" text="Despesa" toggleGroup="$tgType" />
                                                                        <RadioButton fx:id="rbInvestment" styleClass="modern-radio" text="Investimento" toggleGroup="$tgType" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>
                                                        
                                                        <!-- Valor -->
                                                        <VBox spacing="5.0" GridPane.rowIndex="1">
                                                            <children>
                                                                <Label styleClass="form-label" text="Valor (R$)" wrapText="true" />
                                                                <TextField fx:id="txtAmount" promptText="0,00" styleClass="modern-input" />
                                                            </children>
                                                        </VBox>
                                                        
                                                        <!-- Data -->
                                                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                            <children>
                                                                <Label styleClass="form-label" text="Data" wrapText="true" />
                                                                <DatePicker fx:id="dpDate" promptText="dd/mm/aaaa" styleClass="modern-datepicker" />
                                                            </children>
                                                        </VBox>
                                                        
                                                        <!-- Categoria -->
                                                        <VBox spacing="5.0" GridPane.rowIndex="2">
                                                            <children>
                                                                <Label styleClass="form-label" text="Categoria" wrapText="true" />
                                                                <ComboBox fx:id="cbCategory" prefWidth="180.0" promptText="Selecione" styleClass="modern-combo" />
                                                            </children>
                                                        </VBox>
                                                        
                                                        <!-- Descrição -->
                                                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                                            <children>
                                                                <Label styleClass="form-label" text="Descrição (Opcional)" wrapText="true" />
                                                                <TextField fx:id="txtDescription" promptText="Ex: Mercado" styleClass="modern-input" />
                                                            </children>
                                                        </VBox>
                                                        
                                                    </children>
                                                </GridPane>
                                                
                                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                                    <VBox.margin>
                                                        <Insets top="15.0" />
                                                    </VBox.margin>
                                                    <children>
                                                        <Button fx:id="btnCancel" onAction="#handleCancel" styleClass="btn-secondary" text="Cancelar" visible="false" />
                                                        <Button fx:id="btnSave" onAction="#handleSave" styleClass="btn-primary" text="Salvar" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        
                                        <!-- Call-To-Action Card to see the Charts inline -->
                                        <VBox styleClass="card-container" VBox.vgrow="ALWAYS" alignment="CENTER" spacing="18.0">
                                            <padding>
                                                <Insets bottom="25.0" left="20.0" right="20.0" top="25.0" />
                                            </padding>
                                            <children>
                                                <Label text="📈" style="-fx-font-size: 3.5em;" />
                                                <Label styleClass="card-title" text="Relatórios &amp; Análise" wrapText="true" alignment="CENTER" textAlignment="CENTER" />
                                                <Label text="Acesse gráficos interativos de pizza e barras na mesma tela com um clique no botão de alternância." 
                                                       styleClass="form-label" wrapText="true" alignment="CENTER" textAlignment="CENTER" style="-fx-font-weight: normal; -fx-text-fill: -color-text-muted;" />
                                                <Button fx:id="btnOpenCharts" onAction="#handleShowCharts" styleClass="btn-primary" text="Visualizar Gráficos" prefWidth="250.0" style="-fx-padding: 12px 24px; -fx-font-size: 1.1em;" />
                                            </children>
                                        </VBox>
                                        
                                    </children>
                                </VBox>
                                
                            </children>
                        </HBox>
                    </content>
                </Tab>
                
                <!-- Tab 2: Simulador de Investimentos -->
                <Tab text="📈 Simulador de Investimentos">
                    <content>
                        <HBox spacing="20.0">
                            <padding>
                                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                            </padding>
                            <children>
                                
                                <!-- Left Panel: Results, Chart & Table (65% width) -->
                                <VBox spacing="20.0" HBox.hgrow="ALWAYS" prefWidth="800.0">
                                    <children>
                                        
                                        <!-- KPI Cards -->
                                        <HBox spacing="15.0">
                                            <children>
                                                <!-- Total Invested Card -->
                                                <VBox styleClass="kpi-card, kpi-invested" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <Label styleClass="kpi-icon-container" text="💰" wrapText="true" />
                                                                <Label styleClass="kpi-title" text="Total Investido" wrapText="true" />
                                                            </children>
                                                        </HBox>
                                                        <Label fx:id="lblSimTotalInvested" styleClass="kpi-value" text="R$ 0,00" wrapText="true" />
                                                    </children>
                                                </VBox>
                                                
                                                <!-- Total Interest Card -->
                                                <VBox styleClass="kpi-card, kpi-income" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <Label styleClass="kpi-icon-container" text="✨" wrapText="true" />
                                                                <Label styleClass="kpi-title" text="Rendimento em Juros" wrapText="true" />
                                                            </children>
                                                        </HBox>
                                                        <Label fx:id="lblSimTotalInterest" styleClass="kpi-value" text="R$ 0,00" wrapText="true" />
                                                    </children>
                                                </VBox>
                                                
                                                <!-- Final Balance Card -->
                                                <VBox styleClass="kpi-card, kpi-balance-positive" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <Label styleClass="kpi-icon-container" text="📈" wrapText="true" />
                                                                <Label styleClass="kpi-title" text="Montante Final Bruto" wrapText="true" />
                                                            </children>
                                                        </HBox>
                                                        <Label fx:id="lblSimFinalBalance" styleClass="kpi-value" text="R$ 0,00" wrapText="true" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        
                                        <!-- Visualization Container -->
                                        <VBox styleClass="card-container" VBox.vgrow="ALWAYS">
                                            <padding>
                                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                            </padding>
                                            <children>
                                                <HBox alignment="CENTER_LEFT" styleClass="card-header">
                                                    <VBox.margin>
                                                        <Insets bottom="10.0" />
                                                    </VBox.margin>
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                                                            <children>
                                                                <Label styleClass="card-title" text="Evolução do Patrimônio" wrapText="true" />
                                                                <!-- View Switcher -->
                                                                <HBox spacing="5.0" styleClass="segmented-control">
                                                                    <children>
                                                                        <Button fx:id="btnSimViewChart" onAction="#handleShowSimChart" styleClass="btn-segmented, btn-segmented-active" text="📈 Gráfico" />
                                                                        <Button fx:id="btnSimViewTable" onAction="#handleShowSimTable" styleClass="btn-segmented" text="📋 Tabela" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </HBox>
                                                
                                                <StackPane VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <!-- Evolution Chart -->
                                                        <LineChart fx:id="chartSimEvolution" legendSide="BOTTOM" styleClass="modern-chart" title="Evolução Acumulada do Investimento" VBox.vgrow="ALWAYS">
                                                            <xAxis>
                                                                <CategoryAxis fx:id="axisSimPeriod" label="Período" side="BOTTOM" />
                                                            </xAxis>
                                                            <yAxis>
                                                                <NumberAxis fx:id="axisSimAmount" label="Valor (R$)" side="LEFT" />
                                                            </yAxis>
                                                        </LineChart>
                                                        
                                                        <!-- Evolution Table -->
                                                        <TableView fx:id="tvSimEvolution" styleClass="modern-table" visible="false" managed="false">
                                                            <columns>
                                                                <TableColumn fx:id="colSimPeriod" prefWidth="80.0" text="Período" />
                                                                <TableColumn fx:id="colSimInitial" prefWidth="120.0" text="Saldo Inicial" />
                                                                <TableColumn fx:id="colSimContribution" prefWidth="100.0" text="Aporte" />
                                                                <TableColumn fx:id="colSimInterest" prefWidth="110.0" text="Juros do Mês" />
                                                                <TableColumn fx:id="colSimFinal" prefWidth="130.0" text="Saldo Final" />
                                                                <TableColumn fx:id="colSimTotalInvested" prefWidth="130.0" text="Total Investido" />
                                                                <TableColumn fx:id="colSimTotalInterest" prefWidth="130.0" text="Juros Acumulados" />
                                                            </columns>
                                                            <columnResizePolicy>
                                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                            </columnResizePolicy>
                                                        </TableView>
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </VBox>
                                        
                                    </children>
                                </VBox>
                                
                                <!-- Right Panel: Simulator Inputs (35% width) -->
                                <VBox spacing="20.0" prefWidth="440.0" minWidth="400.0">
                                    <children>
                                        <VBox styleClass="card-container, form-card">
                                            <padding>
                                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                            </padding>
                                            <children>
                                                <Label styleClass="card-title" text="Simular Investimento" wrapText="true">
                                                    <VBox.margin>
                                                        <Insets bottom="12.0" />
                                                    </VBox.margin>
                                                </Label>
                                                
                                                <GridPane hgap="10.0" vgap="12.0">
                                                    <columnConstraints>
                                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                    </columnConstraints>
                                                    <rowConstraints>
                                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                                    </rowConstraints>
                                                    <children>
                                                        <!-- Starting Amount -->
                                                        <VBox spacing="5.0" GridPane.columnSpan="2">
                                                            <children>
                                                                <Label styleClass="form-label" text="Valor Inicial (R$)" wrapText="true" />
                                                                <TextField fx:id="txtSimInitialAmount" promptText="Ex: 1000,00" styleClass="modern-input" />
                                                            </children>
                                                        </VBox>
                                                        
                                                        <!-- Monthly Contribution -->
                                                        <VBox spacing="5.0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                                            <children>
                                                                <Label styleClass="form-label" text="Aporte Mensal (R$)" wrapText="true" />
                                                                <TextField fx:id="txtSimMonthlyContribution" promptText="Ex: 100,00" styleClass="modern-input" />
                                                            </children>
                                                        </VBox>
                                                        
                                                        <!-- Interest Rate -->
                                                        <VBox spacing="5.0" GridPane.rowIndex="2">
                                                            <children>
                                                                <Label styleClass="form-label" text="Taxa de Juros (%)" wrapText="true" />
                                                                <TextField fx:id="txtSimInterestRate" promptText="Ex: 1,0 ou 12,0" styleClass="modern-input" />
                                                            </children>
                                                        </VBox>
                                                        
                                                        <!-- Rate Type (Mensal / Anual) -->
                                                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                                            <children>
                                                                <Label styleClass="form-label" text="Tipo de Juros" wrapText="true" />
                                                                <HBox spacing="10.0" alignment="CENTER_LEFT" prefHeight="40.0">
                                                                    <children>
                                                                        <RadioButton fx:id="rbSimMonthly" selected="true" styleClass="modern-radio" text="Mensal">
                                                                            <toggleGroup>
                                                                                <ToggleGroup fx:id="tgSimInterestType" />
                                                                            </toggleGroup>
                                                                        </RadioButton>
                                                                        <RadioButton fx:id="rbSimAnnual" styleClass="modern-radio" text="Anual" toggleGroup="$tgSimInterestType" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>
                                                        
                                                        <!-- Period Count -->
                                                        <VBox spacing="5.0" GridPane.rowIndex="3">
                                                            <children>
                                                                <Label styleClass="form-label" text="Período" wrapText="true" />
                                                                <TextField fx:id="txtSimPeriod" promptText="Ex: 12" styleClass="modern-input" />
                                                            </children>
                                                        </VBox>
                                                        
                                                        <!-- Period Unit (Meses / Anos) -->
                                                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                                            <children>
                                                                <Label styleClass="form-label" text="Unidade do Período" wrapText="true" />
                                                                <ComboBox fx:id="cbSimPeriodType" prefWidth="180.0" styleClass="modern-combo" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </GridPane>
                                                
                                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                                    <VBox.margin>
                                                        <Insets top="20.0" />
                                                    </VBox.margin>
                                                    <children>
                                                        <Button onAction="#handleClearSim" styleClass="btn-secondary" text="Limpar" />
                                                        <Button onAction="#handleCalculateSim" styleClass="btn-primary" text="Calcular" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                                
                            </children>
                        </HBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>

    
</BorderPane>
